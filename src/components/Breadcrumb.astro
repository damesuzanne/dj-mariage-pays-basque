---
import { langFromPath } from '../i18n/routes';
interface Props { title?: string; }
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const en = langFromPath(Astro.url.pathname) === 'en';
const labels: Record<string, string> = en
  ? {
      '/en': 'Home', '/en/tips': 'Tips & resources', '/en/corporate-events': 'Corporate events',
      '/en/bars-restaurants': 'Bars & restaurants', '/en/legal-notice': 'Legal notice',
      '/en/privacy-policy': 'Privacy policy', '/en/contact': 'Contact', '/en/404': 'Page not found',
    }
  : {
      '/': 'Accueil', '/conseils': 'Conseils & ressources', '/entreprises': 'Entreprises',
      '/bars-restaurants': 'Bars & restaurants', '/mentions-legales': 'Mentions légales',
      '/politique-de-confidentialite': 'Politique de confidentialité', '/link-tree': 'Liens utiles', '/contact': 'Contact', '/404': 'Page introuvable',
    };
const home = en ? '/en/' : '/';
const blog = en ? '/en/tips' : '/conseils';
const items = [{ name: en ? 'Home' : 'Accueil', href: home }];
if (path.startsWith(`${blog}/`)) items.push({ name: labels[blog], href: `${blog}/` });
if (path !== '/' && path !== '/en') items.push({ name: labels[path] ?? title?.split(' · ')[0] ?? 'Page', href: Astro.url.pathname });
const schema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: new URL(item.href, 'https://djmariagepaysbasque.fr').href })),
};
---
<nav class:list={['breadcrumb', { 'breadcrumb-inline': path === '/link-tree' }]} aria-label={en ? 'Breadcrumb' : 'Fil d’Ariane'}>
  <ol>
    {items.map((item, i) => <li>
      {i > 0 && <span class="separator" aria-hidden="true">/</span>}
      {i === items.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}
    </li>)}
  </ol>
</nav>
{items.length > 1 && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
<style>
  .breadcrumb { position: absolute; top: 6rem; left: 50%; transform: translateX(-50%); width: min(1120px, 92%); z-index: 4; color: rgba(255,255,255,.65); font-family: var(--font-body, 'Outfit', sans-serif); font-size: .75rem; line-height: 1.5; }
  ol { display: flex; align-items: baseline; flex-wrap: wrap; gap: .25rem .55rem; list-style: none; margin: 0; padding: 0; }
  li { display: inline-flex; align-items: baseline; gap: .55rem; }
  li:last-child { min-width: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--gold-light, #dfc78f); text-decoration: underline; }
  .separator { opacity: .45; }
  .breadcrumb-inline { position: relative; top: auto; left: auto; transform: none; margin: 1rem auto 0; }
  @media (max-width: 600px) { .breadcrumb { top: 5.3rem; font-size: .7rem; } .breadcrumb li:last-child span[aria-current] { max-width: 65vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .breadcrumb-inline { top: auto; } }
</style>
