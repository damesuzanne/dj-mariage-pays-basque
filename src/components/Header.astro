---
import { langFromPath, switchHref } from '../i18n/routes';
import { DRAPEAU_FR, DRAPEAU_EN } from '../i18n/drapeaux';
const path = Astro.url.pathname;
const en = langFromPath(path) === 'en';
const blog = en ? '/en/tips' : '/conseils';
// Sur les articles du blog, le seul H1 doit être le titre de l'article.
const BrandTag = path.startsWith(blog) || path.startsWith(en ? '/en/contact' : '/contact') ? 'div' : 'h1';
const links = en
  ? [{ href: '/en/', label: 'Weddings' }, { href: '/en/corporate-events/', label: 'Corporate Events' }, { href: '/en/bars-restaurants/', label: 'Bars & Restaurants' }, { href: '/en/tips/', label: 'Tips & Resources' }, { href: '/en/contact/', label: 'Contact' }]
  : [{ href: '/', label: 'Mariages' }, { href: '/entreprises/', label: 'Entreprises' }, { href: '/bars-restaurants/', label: 'Bars & Restaurants' }, { href: '/conseils/', label: 'Conseils & Ressources' }, { href: '/contact/', label: 'Contact' }];
const home = en ? '/en/' : '/';
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <BrandTag class="brand">
      <a href={`${home}#accueil`}>
        <span class="brand-mark" aria-hidden="true">R</span>
        <span class="brand-text">
          <span class="brand-name">Richard <em>DJ Event</em></span>
          <span class="brand-tagline">{en ? 'Wedding DJ Biarritz' : 'DJ mariage Pays Basque'}</span>
        </span>
      </a>
    </BrandTag>
    <nav class="nav" id="main-nav" aria-label={en ? 'Main navigation' : 'Navigation principale'}>
      {links.map((link) => <a href={link.href} aria-current={path === link.href || (link.href === `${blog}/` && path.startsWith(blog)) ? "page" : undefined}>{link.label}</a>)}
      <a href={`${home}#devis`} class="btn btn-gold nav-cta">{en ? 'Get a quote' : 'Demander un devis'}</a>
    </nav>
    <div class="lang-switch" role="group" aria-label={en ? 'Language' : 'Langue'}>
      <a href={switchHref(path, 'fr')} hreflang="fr" lang="fr" aria-current={en ? undefined : 'true'} title="Version française"><Fragment set:html={DRAPEAU_FR} />FR</a>
      <span aria-hidden="true">/</span>
      <a href={switchHref(path, 'en')} hreflang="en" lang="en" aria-current={en ? 'true' : undefined} title="English version"><Fragment set:html={DRAPEAU_EN} />EN</a>
    </div>
    <button class="nav-toggle" id="nav-toggle" aria-label={en ? 'Open menu' : 'Ouvrir le menu'} aria-expanded="false" aria-controls="main-nav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
.nav a[aria-current="page"]{color:var(--gold-light);text-decoration:underline;text-underline-offset:7px}

  /* Sélecteur de langue FR / EN : discret, à droite du bouton devis (à côté du menu sur mobile). */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: -0.5rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.35);
  }

  .lang-switch a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    padding: 0.35rem 0.15rem;
    transition: color var(--transition);
  }

  .lang-switch a:hover {
    color: var(--gold-light);
  }

  .lang-switch a[aria-current='true'] {
    color: var(--gold-light);
  }

  .lang-switch :global(.flag) {
    flex-shrink: 0;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);
    opacity: 0.7;
    transition: opacity var(--transition);
  }

  .lang-switch a[aria-current='true'] :global(.flag),
  .lang-switch a:hover :global(.flag) {
    opacity: 1;
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 1.1rem 0;
    transition: background var(--transition), padding var(--transition), box-shadow var(--transition);
  }

  .site-header.is-scrolled {
    background: rgba(16, 21, 34, 0.88);
    backdrop-filter: blur(14px);
    padding: 0.7rem 0;
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.6);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .brand a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--white);
    font-family: var(--font-body);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--gold-light);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand-name {
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .brand-name em {
    font-style: normal;
    color: var(--gold-light);
    font-weight: 400;
  }

  .brand-tagline {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .nav {
    flex-shrink: 0;
    margin-left: auto;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  /* Ordinateur : menu un peu resserré depuis l'ajout du sélecteur FR / EN
     (sinon le slogan sous « Richard DJ Event » passe sur deux lignes). */
  @media (min-width: 1101px) {
    .header-inner {
      gap: 1.3rem;
    }

    .nav {
      gap: 1.2rem;
    }
  }

  .nav a:not(.nav-cta) {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color var(--transition);
  }

  .nav a:not(.nav-cta):hover {
    color: var(--gold-light);
  }

  .nav-cta {
    padding: 0.6rem 1.4rem;
    font-size: 0.9rem;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--white);
    transition: transform var(--transition), opacity var(--transition);
  }

  @media (max-width: 1100px) {
    .nav {
      position: fixed;
      top: 0;
      right: 0;
      height: 100dvh;
      width: min(320px, 80vw);
      flex-direction: column;
      justify-content: center;
      background: var(--night);
      transform: translateX(100%);
      transition: transform var(--transition);
      box-shadow: -20px 0 60px rgba(0, 0, 0, 0.4);
    }

    .nav.is-open {
      transform: none;
    }

    .nav-toggle {
      display: flex;
      z-index: 60;
    }

    .lang-switch {
      margin-left: auto;
      margin-right: -1rem;
      z-index: 60;
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 30);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });

  nav?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
