---
/**
 * En-tête des pages intérieures (Contact, Conseils & ressources) : même mise en page que
 * l'en-tête de l'accueil, des Entreprises et des Bars & restaurants (texte centré, surtitre doré,
 * titre sur deux lignes dont la seconde en italique doré, photo sombre en fond).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker: string;
  ligne1: string;
  accent: string;
  texte: string;
  image?: ImageMetadata;
  imageAlt?: string;
  position?: string;
}
const { kicker, ligne1, accent, texte, image, imageAlt = '', position = 'center 40%' } = Astro.props;
---

<header class="page-hero">
  <div class="page-hero-bg" aria-hidden={imageAlt ? undefined : 'true'}>
    {image && (
      <Image
        src={image}
        alt={imageAlt}
        class="page-hero-photo"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={72}
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${position}`}
      />
    )}
    <div class="page-hero-overlay"></div>
    <div class="page-hero-grain"></div>
  </div>
  <div class="container page-hero-inner">
    <p class="page-hero-kicker">{kicker}</p>
    <h1 class="page-hero-title">
      <span>{ligne1}</span>
      <span class="accent">{accent}</span>
    </h1>
    <p class="page-hero-sub">{texte}</p>
    <div class="page-hero-actions"><slot name="actions" /></div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: min(62dvh, 560px);
    background: var(--night);
    color: var(--white);
    padding: 8.5rem 0 4.5rem;
  }
  .page-hero-bg { position: absolute; inset: 0; z-index: -1; }
  .page-hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 21, 34, 0.88) 0%, rgba(16, 21, 34, 0.72) 45%, rgba(16, 21, 34, 0.92) 100%);
  }
  .page-hero-grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: linear-gradient(to bottom, transparent, black 30%, black 75%, transparent);
  }
  .page-hero-inner { position: relative; max-width: 780px; text-align: center; margin-inline: auto; }
  .page-hero-kicker {
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--gold-light);
    margin: 0 0 1.4rem;
  }
  .page-hero-title {
    font-size: clamp(1.9rem, 6vw, 3.4rem);
    color: var(--white);
    margin: 0 0 1.2rem;
  }
  .page-hero-title span { display: block; }
  .page-hero-title .accent {
    background: linear-gradient(120deg, var(--gold-light), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
    font-weight: 400;
  }
  .page-hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 2rem; }
  .page-hero-actions:empty { display: none; }
  .page-hero-sub {
    font-size: 1.12rem;
    color: rgba(255, 255, 255, 0.75);
    max-width: 560px;
    margin: 0 auto;
    font-weight: 300;
  }
</style>
