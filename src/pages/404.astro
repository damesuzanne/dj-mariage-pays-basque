---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page introuvable · Richard DJ Event"
  description="Cette page n’existe pas ou a été déplacée. Retrouvez Richard DJ Event et ses prestations pour votre mariage."
  noindex
>
  <Header />

  <main class="not-found">
    <div class="glow glow-one" aria-hidden="true"></div>
    <div class="glow glow-two" aria-hidden="true"></div>

    <div class="container not-found-inner">
      <div class="monogram" aria-hidden="true">R</div>
      <p class="error-code">Erreur 404</p>
      <h1>Cette page a quitté <em>la piste de danse</em></h1>
      <p class="intro">
        Le lien suivi n’existe plus ou l’adresse saisie contient une erreur. Votre projet de
        mariage, lui, peut continuer ici.
      </p>

      <div class="actions">
        <a class="btn btn-gold" href="/">Retour à l’accueil</a>
        <a class="btn btn-outline" href="/#devis">Demander une disponibilité</a>
      </div>

      <div class="quick-contact">
        <span>Besoin d’une réponse rapide ?</span>
        <a href="tel:+33684331824">06 84 33 18 24</a>
        <span class="separator" aria-hidden="true">·</span>
        <a
          href="https://wa.me/33684331824?text=Bonjour%20Richard%2C%20je%20souhaite%20des%20informations%20pour%20mon%20mariage."
          target="_blank"
          rel="noopener"
        >
          WhatsApp
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .not-found {
    position: relative;
    display: grid;
    min-height: 78vh;
    overflow: hidden;
    place-items: center;
    padding: clamp(9rem, 16vw, 12rem) 0 clamp(5rem, 9vw, 7rem);
    color: var(--white);
    background:
      radial-gradient(circle at 50% 15%, rgba(198, 161, 91, 0.18), transparent 38%),
      linear-gradient(145deg, var(--night), #171e2e 58%, #0c101a);
  }

  .not-found-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    text-align: center;
  }

  .monogram {
    display: grid;
    width: 78px;
    height: 78px;
    margin: 0 auto 1.5rem;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold-light);
    font: 500 2.7rem/1 var(--font-display);
    place-items: center;
    box-shadow: 0 0 0 9px rgba(198, 161, 91, 0.07);
  }

  .error-code {
    margin: 0 0 0.8rem;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 680px;
    margin: 0 auto 1.2rem;
    color: var(--white);
    font-size: clamp(2.5rem, 7vw, 4.8rem);
  }

  h1 em {
    color: var(--gold-light);
  }

  .intro {
    max-width: 610px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(1rem, 2vw, 1.16rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2.3rem;
  }

  .quick-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.9rem;
  }

  .quick-contact a {
    color: var(--gold-light);
    font-weight: 600;
    text-decoration: none;
  }

  .quick-contact a:hover {
    text-decoration: underline;
  }

  .glow {
    position: absolute;
    border: 1px solid rgba(198, 161, 91, 0.12);
    border-radius: 50%;
  }

  .glow-one {
    top: -180px;
    left: -160px;
    width: 480px;
    height: 480px;
  }

  .glow-two {
    right: -220px;
    bottom: -260px;
    width: 620px;
    height: 620px;
  }

  @media (max-width: 560px) {
    .not-found {
      min-height: 82vh;
    }

    .actions {
      display: grid;
    }

    .actions .btn {
      width: 100%;
    }

    .quick-contact {
      display: grid;
      gap: 0.35rem;
    }

    .separator {
      display: none;
    }
  }
</style>
