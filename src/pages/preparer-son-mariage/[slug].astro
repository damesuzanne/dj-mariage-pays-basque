---
import { fr } from '../../utils/typo';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RessourceCta from '../../components/RessourceCta.astro';
import { ressources } from '../../data/ressources';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, h1, description, date, updated, categorie, tempsLecture, faq, image, imageAlt } = article.data;
const ressource = ressources[article.data.ressource];

const siteUrl = 'https://djmariagepaysbasque.fr';
const url = `${siteUrl}/preparer-son-mariage/${article.id}/`;
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: h1 ?? title,
      image: new URL((image ?? ressource.couverture).src, siteUrl).toString(),
      description,
      datePublished: date.toISOString(),
      dateModified: (updated ?? date).toISOString(),
      inLanguage: 'fr-FR',
      mainEntityOfPage: url,
      author: { '@type': 'Person', name: 'Richard Nivet', url: siteUrl },
      publisher: { '@id': `${siteUrl}/#business` },
    },
    ...(faq.length
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faq.map(({ q, r }) => ({
              '@type': 'Question',
              name: q,
              acceptedAnswer: { '@type': 'Answer', text: r },
            })),
          },
        ]
      : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Préparer son mariage', item: `${siteUrl}/preparer-son-mariage/` },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---

<Layout title={title.length > 55 ? title : `${title} · Richard DJ Event`} description={description}>
  <Header />
  <header class:list={['post-hero', { 'has-image': image }]}>
    <div class="container post-hero-inner">
      <nav class="crumbs" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/preparer-son-mariage/">Préparer son mariage</a>
      </nav>
      <p class="eyebrow">{categorie}</p>
      <h1 class="post-title">{fr(h1 ?? title)}</h1>
      <p class="post-meta">
        Par Richard, DJ mariage · <time datetime={date.toISOString()}>{fmt(date)}</time>
        {tempsLecture && <> · {tempsLecture} min de lecture</>}
      </p>
    </div>
    {image && (
      <div class="container post-hero-media">
        <Image src={image} alt={imageAlt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 92vw, 860px" class="post-hero-img" loading="eager" fetchpriority="high" />
      </div>
    )}
  </header>

  <main class="container post">
    <article class="prose">
      <Content components={{ Guide: RessourceCta }} />
      {faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-titre">
          <h2 id="faq-titre">Questions fréquentes</h2>
          {faq.map(({ q, r }) => (
            <details>
              <summary>{fr(q)}</summary>
              <p>{fr(r)}</p>
            </details>
          ))}
        </section>
      )}
    </article>
  </main>

  <section class="post-end">
    <div class="container post-end-inner">
      <p class="eyebrow">Votre DJ mariage</p>
      <h2>Et pour la musique, <em>on en parle&nbsp;?</em></h2>
      <p>
        Plus de 200 mariages animés au Pays Basque et dans les Landes. Dites-moi votre date et votre lieu, je vous
        réponds sous 24h.
      </p>
      <a href="/#devis" class="btn btn-gold">Vérifier ma date</a>
    </div>
  </section>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</Layout>

<style>
  .post-hero {
    background: var(--night);
    color: var(--white);
    padding: 8.5rem 0 3.2rem;
  }
  .post-hero-inner {
    max-width: 760px;
  }
  .post-hero.has-image {
    padding-bottom: 0;
    background: linear-gradient(var(--night) 70%, var(--cream) 70%);
  }
  .post-hero-media {
    max-width: 860px;
    margin-top: 2.4rem;
  }
  .post-hero-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1.6rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .crumbs a {
    color: var(--gold-light);
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .post-title {
    color: var(--white);
    font-size: clamp(2rem, 5vw, 3.1rem);
    margin-bottom: 0.8rem;
  }
  .post-meta {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.92rem;
  }
  .post {
    max-width: 760px;
    padding: 3rem 0 2rem;
  }
  .prose {
    font-size: 1.08rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    font-size: clamp(1.55rem, 3.4vw, 2rem);
    margin: 2.6rem 0 0.8rem;
  }
  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 2rem 0 0.6rem;
  }
  .prose :global(p) {
    margin: 0 0 1.1rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
    margin: 0 0 1.2rem;
  }
  .prose :global(li) {
    margin: 0.35rem 0;
  }
  .prose :global(li::marker) {
    color: var(--gold);
  }
  .prose :global(a:not(.btn)) {
    color: var(--night);
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    color: var(--night);
  }
  .prose :global(blockquote) {
    margin: 1.6rem 0;
    padding: 1rem 1.3rem;
    background: var(--cream-deep);
    border-left: 3px solid var(--gold);
    border-radius: 4px 14px 14px 4px;
  }
  .prose :global(blockquote p:last-child) {
    margin: 0;
  }
  .faq {
    margin-top: 3rem;
  }
  .faq details {
    border-bottom: 1px solid #eadfc8;
    padding: 0.9rem 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--night);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq summary::after {
    content: '+';
    color: var(--gold);
    font-size: 1.3rem;
    line-height: 1;
  }
  .faq details[open] summary::after {
    content: '–';
  }
  .faq details p {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
  }
  .post-end {
    background: var(--cream-deep);
    text-align: center;
  }
  .post-end-inner {
    max-width: 620px;
  }
  .post-end h2 {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }
  .post-end p {
    color: var(--ink-soft);
    margin: 0 0 1.6rem;
  }
</style>
