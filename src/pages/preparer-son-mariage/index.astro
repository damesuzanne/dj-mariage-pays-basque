---
import { fr } from '../../utils/typo';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ressources } from '../../data/ressources';

const articles = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const visuel = (a: (typeof articles)[number]) => a.data.image ?? ressources[a.data.ressource].couverture;
---

<Layout
  title="Préparer son mariage : conseils, checklist et guides gratuits · Richard DJ Event"
  description="Conseils pratiques pour organiser votre mariage au Pays Basque et dans les Landes : rétroplanning, budget, animations, musique. Avec des guides gratuits à télécharger."
>
  <Header />
  <header class="blog-hero">
    <div class="container blog-hero-inner">
      <p class="eyebrow">Préparer son mariage</p>
      <h1>Préparer son mariage, <em>sereinement</em></h1>
      <p>
        Des repères concrets tirés de plus de 200 mariages animés, et des guides gratuits à télécharger pour avancer à
        votre rythme.
      </p>
    </div>
  </header>

  <main class="container blog-main">
    <section class="grid" aria-label="Articles">
      {articles.map((a, i) => (
        <a href={`/preparer-son-mariage/${a.id}/`} class="card">
          <div class="card-media">
            <Image
              src={visuel(a)}
              alt={a.data.imageAlt}
              widths={[480, 720, 960]}
              sizes="(max-width: 760px) 92vw, 540px"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="card-body">
            <p class="kicker">{a.data.categorie}</p>
            <h2 class="card-title">{fr(a.data.h1 ?? a.data.title)}</h2>
            <p class="card-desc">{fr(a.data.description)}</p>
            <p class="meta">
              {fmt(a.data.date)}{a.data.tempsLecture && <> · {a.data.tempsLecture} min de lecture</>}
            </p>
            <span class="read">Lire l'article <svg class="read-arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <p class="offert">
              <span class="offert-dot" aria-hidden="true"></span>{ressources[a.data.ressource].type} offert&nbsp;: {ressources[a.data.ressource].titre}
            </p>
          </div>
        </a>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-hero {
    background: var(--night);
    color: var(--white);
    padding: 8.5rem 0 3.5rem;
  }
  .blog-hero-inner {
    max-width: 720px;
  }
  .blog-hero h1 {
    color: var(--white);
    font-size: clamp(2.2rem, 5vw, 3.3rem);
  }
  .blog-hero p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }
  .blog-main {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3.5rem, 8vw, 6rem);
  }

  .kicker {
    margin: 0 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .meta {
    margin: 0 0 1.4rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--night);
  }
  .read-arrow {
    color: var(--gold);
    transition: transform var(--transition);
  }
  .card:hover .read-arrow {
    transform: translateX(4px);
  }
  .offert {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1.8rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid #eadfc8;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .offert-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--gold);
    flex: none;
  }

  /* Grille d'articles : toutes les cartes ont la même présentation */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .card-media {
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 1.4rem;
  }
  .card-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 50% 40%;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .card-media :global(img) {
    transform: scale(1.03);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-title {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    margin: 0 0 0.7rem;
  }
  .card-desc {
    margin: 0 0 0.9rem;
    color: var(--ink-soft);
  }
  .card .offert {
    margin-top: auto;
  }
  .card .read {
    margin-bottom: 1.4rem;
  }

</style>
